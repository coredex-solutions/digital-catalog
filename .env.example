# ============================================
# Turso Database Configuration
# ============================================
# Get these from your Turso dashboard: https://turso.tech
# Database URL format: libsql://your-database-name-username.turso.io
TURSO_DATABASE_URL=libsql://your-database-name-username.turso.io
# Auth token from Turso dashboard
TURSO_AUTH_TOKEN=your-turso-auth-token

# ============================================
# Cloudflare R2 Storage Configuration
# ============================================
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
# Your Cloudflare Account ID (found in dashboard URL or account settings)
R2_ACCOUNT_ID=your-cloudflare-account-id
# R2 Access Key ID
R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2 Bucket Name (the name of your R2 bucket)
R2_BUCKET_NAME=your-bucket-name
# Optional: Public URL for R2 bucket (if using custom domain)
# If not set, defaults to: https://pub-{R2_ACCOUNT_ID}.r2.dev
# R2_PUBLIC_URL=https://your-custom-domain.com

# ============================================
# Authentication & Security
# ============================================
# JWT Secret for token signing (REQUIRED - the app refuses to sign or accept tokens without it)
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# ============================================
# Admin User Creation (Optional)
# ============================================
# These are only used when running: npm run create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ============================================
# Email (verification codes at signup)
# ============================================
# Any SMTP provider: your domain's mailbox, Google Workspace, Zoho, Brevo, Resend SMTP...
# Port 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional sender address if different from SMTP_USER
# EMAIL_FROM=info@your-domain.com

# ============================================
# Public address
# ============================================
# Used for QR codes, links, the sitemap and social previews. Built into the pages,
# so set it before `npm run build`. No trailing slash.
NEXT_PUBLIC_BASE_URL=https://your-domain.com
