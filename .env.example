# ============================================
# Turso Database Configuration
# ============================================
# Get these from your Turso dashboard: https://turso.tech
# Database URL format: libsql://your-database-name-username.turso.io
TURSO_DATABASE_URL=libsql://your-database-name-username.turso.io
# Auth token from Turso dashboard
TURSO_AUTH_TOKEN=your-turso-auth-token

# ============================================
# Cloudflare R2 Storage Configuration
# ============================================
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
# Your Cloudflare Account ID (found in dashboard URL or account settings)
R2_ACCOUNT_ID=your-cloudflare-account-id
# R2 Access Key ID
R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2 Bucket Name (the name of your R2 bucket)
R2_BUCKET_NAME=your-bucket-name
# Optional: Public URL for R2 bucket (if using custom domain)
# If not set, defaults to: https://pub-{R2_ACCOUNT_ID}.r2.dev
# R2_PUBLIC_URL=https://your-custom-domain.com

# ============================================
# Authentication & Security
# ============================================
# JWT Secret for token signing (REQUIRED - the app refuses to sign or accept tokens without it)
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# ============================================
# Admin User Creation (Optional)
# ============================================
# These are only used when running: npm run create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ============================================
# Email (verification codes at signup)
# ============================================
# Any SMTP provider: your domain's mailbox, Google Workspace, Zoho, Brevo, Resend SMTP...
# Port 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional sender address if different from SMTP_USER
# EMAIL_FROM=info@your-domain.com
# Where plan requests are announced (defaults to EMAIL_FROM, then SMTP_USER)
# OPS_EMAIL=ops@your-domain.com

# ============================================
# Daily reminder emails (plan ending / ended)
# ============================================
# The server's crontab calls /api/cron/reminders/ with this secret (deploy/README.md)
# Generate one with: openssl rand -hex 24
CRON_SECRET=

# ============================================
# Sales contact on the marketing site
# ============================================
# WhatsApp number with country code, digits only. Rebuild after changing.
# NEXT_PUBLIC_SALES_WHATSAPP=961XXXXXXXX

# ============================================
# AI photos and reading printed menus (Google Gemini)
# ============================================
# One key for both: "AI photo" on a dish, and importing dishes from a photo or PDF of a menu.
# Without it those two features say they aren't set up; everything else works.
# GOOGLE_API_KEY=

# ============================================
# AI model names (optional)
# ============================================
# Defaults live in lib/ai/models.ts. Providers retire models every few months; when one is
# shut down, set its replacement here and restart (no rebuild needed).
# GEMINI_TEXT_MODEL=gemini-3.8-flash          # reading printed menus
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite     # AI waiter answers and training
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image   # AI photos
# GROQ_TEXT_MODEL=openai/gpt-oss-20b          # writing the About page (GROQ_API_KEY)
# GROQ_STT_MODEL=whisper-large-v3             # guests' voice questions (GROQ_API_KEY)
# OPENAI_TTS_MODEL=tts-1                      # spoken replies via OpenAI (OPENAI_API_KEY)

# ============================================
# AI waiter voice (optional)
# ============================================
# Spoken replies use Google Cloud Text-to-Speech (this key, else GOOGLE_API_KEY) or OpenAI.
# Without either, guests' phones read the replies with their built-in voice.
# GOOGLE_TTS_API_KEY=

# ============================================
# Public address
# ============================================
# Used for QR codes, links, the sitemap and social previews. Built into the pages,
# so set it before `npm run build`. No trailing slash.
NEXT_PUBLIC_BASE_URL=https://your-domain.com
